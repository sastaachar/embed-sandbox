{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "embed-sandbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // Static files only — /_static/runtime.js. Assets are matched before the
  // Worker runs, so every other path (/, /api, /mcp, /p/...) falls through.
  "assets": { "directory": "./public" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "embed-sandbox",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
